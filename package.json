{
  "name": "dao-den-long",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Đảo Đèn Lồng — game 3D góc nhìn thứ ba (Day 12 AI SDLC lab)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:headless && npm run build:web",
    "build:headless": "node scripts/build-node.mjs",
    "build:web": "vite build",
    "dev": "vite",
    "start": "node build/serve.mjs",
    "headless": "node build/headless.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:headless --silent && tsc --noEmit && vitest run",
    "verify": "node scripts/verify.mjs",
    "shot": "node scripts/screenshot.mjs",
    "bench": "node scripts/bench.mjs",
    "soak": "node --expose-gc --jitless --single-threaded --max-semi-space-size=1 build/soak.mjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/three": "0.170.0",
    "esbuild": "0.24.2",
    "playwright": "^1.49.1",
    "typescript": "5.7.2",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
